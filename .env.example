# Copia este archivo a .env.local y genera un valor con: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=
AUTH_URL=
NEXTAUTH_URL=

# Supabase — Project Settings → API en el dashboard de Supabase
# URL del proyecto (no es secreta)
NEXT_PUBLIC_SUPABASE_URL=
# service_role key (SECRETA — nunca la pongas con prefijo NEXT_PUBLIC_,
# nunca la expongas al cliente; bypassa RLS y solo la usan los Server Actions)
SUPABASE_SERVICE_ROLE_KEY=
